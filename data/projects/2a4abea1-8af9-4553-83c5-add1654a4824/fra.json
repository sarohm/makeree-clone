   },
   "stepGroup": "Addressable LED strip",
   "stepGroupId": 1
  },
  {
   "stepId": 4,
   "url": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/b829a14a-ea47-4e4d-8f04-b2280357e458.jpg",
   "urlTablet": "",
   "urlMobile": "",
   "thumbUrl": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/b829a14a-ea47-4e4d-8f04-b2280357e458_thumb.jpg",
   "text": "Let's start with a repeat-between block for scanning the LEDs. A repeat betweenblock, as the name implies, may be used for repeating an action (or series of actions) while keeping track of the number of times the action has been executed",
   "title": "",
   "addToBackground": false,
   "muted": false,
   "autoPlay": false,
   "isGalleryStep": false,
   "isDominantText": false,
   "type": 1,
   "tips": [],
   "contentTips": [],
   "extraData": {

   "thumbUrl": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/ca9c8257-3c15-45ff-a75e-f71b1bc1c728_thumb.jpg",
   "text": "Take the 'neopixel init' block from the Display drawer and attach it to the setup socket. This block allows us to declare what pin we are connected to, how many LEDs are in our strip and wat is the color scheme and communication speed.",
   "title": "",
   "addToBackground": false,
   "muted": false,
   "autoPlay": false,
   "isGalleryStep": false,
   "isDominantText": false,
   "type": 1,

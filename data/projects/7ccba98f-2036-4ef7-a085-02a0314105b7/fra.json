  {
   "stepId": 2,
   "url": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/719b73ae-f498-4315-8caa-fadea6f7a6ea.jpg",
   "urlTablet": "",
   "urlMobile": "",
   "thumbUrl": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/719b73ae-f498-4315-8caa-fadea6f7a6ea_thumb.jpg",
   "text": "What's a survey? A survey is a counter that counts the number of votes people gave to 2 options or more, presented to them. Do you start seeing the connection to 'The Counter Project' from before? All we are going to is add another button and attach it to a counter and Voilà! We will have a physical-digital survey! Let's get started",
   "title": "",
   "addToBackground": false,
   "muted": false,
   "autoPlay": false,
   "isGalleryStep": false,
   "isDominantText": false,
   "type": 1,
   "tips": [],

     "isOpened": false,
     "openAutoSec": 0,
     "data": {
      "$type": "Makeree.Model.Responses.LessonStepTipImageDataDto, Makeree.Model",
      "items": [
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_engine2.jpg",
        "text": "A few stripping techniques will be introduced. Choose the one you find most convenient. Begin with holding the cutters in parallel to the wire.",
        "type": 1
       },
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_engine3.jpg",
        "text": "Cut the coating in parallel to the direction of the wire, avoid cutting the conductive wire itself.",
        "type": 1
       },
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_engine4.jpg",
        "text": "",
        "type": 1
       },
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_engine5.jpg",
        "text": "Repeat cutting in a parallel manner.",
        "type": 1
       },
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_engine6.jpg",
        "text": "Gradually cut the entire length and peel the coating off.",
        "type": 1
       },
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_wire1.jpg",
        "text": "The second stripping method, requires cutting the isolation coating in perpendicular to the wire's direction. Try to avoid cutting the conductive wire itself.",
        "type": 1
       },
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_wire2.jpg",
        "text": "Create incisions and divide the coating into 2''(5 cm) segments. ",
        "type": 1
       },
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_wire3.jpg",
        "text": "",
        "type": 1
       },
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_wire5.jpg",
        "text": "Gradually, section by section, peel the isolating coating off.",
        "type": 1
       },
       {
        "url": "https://d1xhvexl2i3ere.cloudfront.net/Resources/02/02_wire7.jpg",
        "text": "Repeat this process until the wire is fully exposed.",
        "type": 1
       }
      ]
     },
     "width": 0.0,
     "height": 0.0
    }

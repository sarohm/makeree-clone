   "stepGroupId": 2
  },
  {
   "stepId": 3,
   "url": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/b9a1ded5-52c6-4309-9b2c-ca4e5ad9169b.jpg",
   "urlTablet": "",
   "urlMobile": "",

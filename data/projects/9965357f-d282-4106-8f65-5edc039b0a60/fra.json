     "isOpened": false,
     "openAutoSec": 0,
     "data": {
      "$type": "Makeree.Model.Responses.LessonStepTipTextDataDto, Makeree.Model",
      "text": "3.\tThe circuit needs calibration, i.e. changing the pot resistance until it balances the light sensor resistance, keeping the motor inactive. As soon as the light sensor gets more light, the balance is disturbed, the transistor is activated and the motor starts spinning."
     },
     "width": 0.0,
     "height": 0.0
    }
   ],

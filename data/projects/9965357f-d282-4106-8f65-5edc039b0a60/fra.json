     "isOpened": false,
     "openAutoSec": 0,
     "data": {
      "$type": "Makeree.Model.Responses.LessonStepTipTextDataDto, Makeree.Model",
      "text": "The voltage in row 6 controls whether or not the transistor, acting as a switch, activates the motor."
     },
     "width": 0.0,
     "height": 0.0
    },
    {
     "x": 208,
     "y": 428,
     "type": 0,
     "iconType": 0,

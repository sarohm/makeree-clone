   "urlTablet": "",
   "urlMobile": "",
   "thumbUrl": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/0d500ac9-6616-4665-9d79-98c342c9cd26_thumb.jpg",
   "text": "Now let's read the sensor value and place it inside our new variable, for comparing against it in the future.",

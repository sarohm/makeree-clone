   "urlMobile": "",
   "thumbUrl": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/b2aa0b0c-74dc-4c0f-8982-f741d31ad69b_thumb.jpg",
   "text": "Let's change the name of the variable - i.e. the memory location, where the sensor's initial reading will be stored - to 'baseline'.",

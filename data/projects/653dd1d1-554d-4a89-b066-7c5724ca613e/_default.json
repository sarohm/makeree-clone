   "urlMobile": "",
   "thumbUrl": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/dc251ffe-66d0-4114-b6df-c790b430acf0_thumb.jpg",
   "text": "And just to make things even more perfect, we will add an absolute value block that will allow us not to care what was the direction of the change in the sensor reading, i.e. whether it got smaller or bigger",
   "title": "",
   "addToBackground": false,
   "muted": false,
   "autoPlay": false,

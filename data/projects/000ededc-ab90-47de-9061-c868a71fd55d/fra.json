   "text": "Add by adding a smart led (neopixel) init block in the setup socket",
   "title": "",
   "addToBackground": false,
   "muted": false,
   "autoPlay": false,
   "isGalleryStep": false,
   "isDominantText": false,
   "type": 1,
   "tips": [],

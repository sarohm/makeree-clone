   "text": "Initializations done! Now add a Blynk run block, added to the loop socket, taking care of maintaining the communication channel with Blynk server",
   "title": "",
   "addToBackground": false,
   "muted": false,
   "autoPlay": false,
   "isGalleryStep": false,
   "isDominantText": false,
   "type": 1,

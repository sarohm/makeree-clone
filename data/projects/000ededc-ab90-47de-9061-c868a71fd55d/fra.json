  },
  {
   "stepId": 2,
   "url": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/d7a42907-ba5f-4bf1-9c00-37d3ebf53f28.jpg",
   "urlTablet": "",
   "urlMobile": "",
   "thumbUrl": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/d7a42907-ba5f-4bf1-9c00-37d3ebf53f28_thumb.jpg",
   "text": "In this module, we will connect an individually addressable led strip to the internet, using Integromat and Blynk! Let's start by replacing the loop with a program block block that will, as usual, accommodate for initializations",
   "title": "",
   "addToBackground": false,
   "muted": false,
   "autoPlay": false,
   "isGalleryStep": false,
   "isDominantText": false,
   "type": 1,

   "text": "next, add a Blynk initialization block for your ESP8266 controller, and set Wifi credentials according to your Wifi",
   "title": "",
   "addToBackground": false,
   "muted": false,
   "autoPlay": false,
   "isGalleryStep": false,
   "isDominantText": false,

   },
   "stepGroup": "Hooking up the Module",
   "stepGroupId": 2
  },
  {
   "stepId": 9,
   "url": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/94b098fd-fbf0-499f-bf06-ffb59313a730.jpg",
   "urlTablet": "",
   "urlMobile": "",
   "thumbUrl": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/94b098fd-fbf0-499f-bf06-ffb59313a730_thumb.jpg",
   "text": "Start by removing the loop and adding a program block, that will be used to initialize the MP3 player",
   "title": "",
   "addToBackground": false,
   "muted": false,
   "autoPlay": false,
   "isGalleryStep": false,
   "isDominantText": false,

   "stepGroup": "The Code",
   "stepGroupId": 3
  },
  {
   "stepId": 10,
   "url": "https://d1xhvexl2i3ere.cloudfront.net/makeree/res/800209e6-4b43-4a95-83b3-dc1453ad6b70.jpg",
   "urlTablet": "",
   "urlMobile": "",
